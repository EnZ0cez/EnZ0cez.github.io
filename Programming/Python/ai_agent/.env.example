# Copy this file to .env and fill in your own values. Never commit .env.

# Use local Ollama (true) or a cloud API (false)
USE_OLLAMA=true

# Local Ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=
OLLAMA_STREAM=false

# Cloud API type: openai (OpenAI/Claude-compatible) or dashscope (Alibaba Cloud)
CLOUD_API_TYPE=dashscope
# Your cloud API key — get a new one from your provider; do not reuse a leaked key
CLOUD_API_KEY=
# Cloud API base URL
CLOUD_BASE_URL=
CLOUD_MODEL_NAME=
CLOUD_STREAM=false
