# 选择使用本地Ollama还是云端API
# 设置为true使用本地Ollama，设置为false使用云端API
USE_OLLAMA=false

# === 本地Ollama配置（当 USE_OLLAMA=true 时使用） ===
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:270m
OLLAMA_STREAM=false

# === 云端API配置（当 USE_OLLAMA=false 时使用） ===
# 云端API类型：openai（OpenAI/Claude等兼容API）或 dashscope（阿里云百炼）
CLOUD_API_TYPE=dashscope
# 云端API密钥
CLOUD_API_KEY=sk-c8051f50e9644fa59e069c3cd57449e2
# 云端API基础URL（阿里云百炼示例）
CLOUD_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 模型名称
CLOUD_MODEL_NAME=glm-4.5
# 是否使用流式输出模式
CLOUD_STREAM=true